# The VM disks and snapshots are not in this repository: see VM_DATA in README.md.
# These stay ignored in case an old checkout still has them here.
macos15/macos-data/
win11/windows-data/
macos15/snapshots/
win11/snapshots/

# Xcode, which is downloaded by hand (2.7 GB). It belongs in ~/.local/share/vm/downloads/,
# which the macOS VM sees as /Volumes/shared/downloads. These keep one from being added by
# accident, and the mount point that podman makes in shared/.
*.xip
macos15/shared/downloads/

# logs: the setup scripts write them, and they are kept for reference only
logs/
*.log
